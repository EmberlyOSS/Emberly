# ── Required ────────────────────────────────────────────────────────────────

# Public address of your instance, without a trailing slash
APP_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

DATABASE_URL="postgresql://emberly:emberly@localhost:5432/emberly"
REDIS_URL="redis://localhost:6379"

# ── Instance ────────────────────────────────────────────────────────────────

# License key for white-label branding. You can also paste it in
# Admin → Settings → License & branding instead.
EMBERLY_LICENSE_KEY=""
# Licensed instances check in daily to pick up renewed keys. Set to false
# for servers that cannot reach licenses.embrly.ca and renew keys by hand.
EMBERLY_LICENSE_CHECKIN="true"

# Run background jobs inside the app process. Set to false when you run
# `bun run worker` as a separate service.
EMBERLY_RUN_EVENT_WORKER="true"

# Extra origins allowed to sign in, comma separated (e.g. custom domains)
NEXTAUTH_TRUSTED_ORIGINS=""

# Share the session cookie across subdomains of one domain (e.g. .example.com)
NEXTAUTH_COOKIE_DOMAIN=""

# ── Storage ─────────────────────────────────────────────────────────────────

# Where locally stored uploads live. Defaults to the repository root (/data in Docker).
DATA_DIR=""

# Use S3-compatible storage (AWS, R2, Backblaze, RustFS, MinIO...) instead of
# the local disk. Overrides the storage settings in Admin → Settings.
STORAGE_PROVIDER=""
S3_ENDPOINT=""
S3_PUBLIC_ENDPOINT=""
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=""

# ── Email (optional, also configurable in Admin → Settings) ─────────────────

EMAIL_FROM=""
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# ── Integrations (optional) ─────────────────────────────────────────────────

VIRUSTOTAL_API_KEY=""

# Account connections
DISCORD_OAUTH_CLIENT_ID=""
DISCORD_OAUTH_CLIENT_SECRET=""
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# Error reporting
NEXT_PUBLIC_SENTRY_DSN=""