# ── Required ────────────────────────────────────────────────────────────────

# Public address of your instance, without a trailing slash
APP_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

DATABASE_URL="postgresql://emberly:emberly@localhost:5432/emberly"
REDIS_URL="redis://localhost:6379"

# ── Instance ────────────────────────────────────────────────────────────────

# Run background jobs inside the app process. Set to false when you run
# `bun run worker` as a separate service.
EMBERLY_RUN_EVENT_WORKER="true"

# Extra origins allowed to sign in, comma separated (e.g. custom domains)
NEXTAUTH_TRUSTED_ORIGINS=""

# Share the session cookie across subdomains of one domain (e.g. .example.com)
NEXTAUTH_COOKIE_DOMAIN=""

# ── Email (optional, also configurable in Admin → Settings) ─────────────────

EMAIL_FROM=""
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# ── Integrations (optional) ─────────────────────────────────────────────────

VIRUSTOTAL_API_KEY=""

# Account connections
DISCORD_OAUTH_CLIENT_ID=""
DISCORD_OAUTH_CLIENT_SECRET=""
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# Error reporting
NEXT_PUBLIC_SENTRY_DSN=""