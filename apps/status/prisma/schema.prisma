generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String            @id @default(cuid())
  name               String?
  username           String?           @unique
  email              String?           @unique
  emailVerified      DateTime?
  hashedPassword     String?
  image              String?
  role               UserRole          @default(BASE_USER)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  accounts           Account[]
  sessions           Session[]
  statusSubscription StatusSubscriber?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String // CREATE, UPDATE, DELETE
  entityType  String // POSITION, BLOG_POST, USER, REVIEW, etc.
  entityId    String? // ID of the affected entity
  entityTitle String? // Title/name for display
  userId      String? // Who performed the action
  userName    String? // Cached user name for display
  details     String? // Additional details
  createdAt   DateTime @default(now())
}

enum UserRole {
  SUPER_ADMIN
  ADMINISTRATOR
  BASE_USER
}

// ─── Status Page ──────────────────────────────────────────────────────────────

enum ComponentStatus {
  OPERATIONAL
  DEGRADED_PERFORMANCE
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
  UNDER_MAINTENANCE
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum MaintenanceStatus {
  NOT_STARTED_YET
  IN_PROGRESS
  COMPLETED
}

enum HomePageDisplay {
  COMPONENTS
  RESPONSE_TIMES
  BOTH
}

// Singleton row (fixed id) holding site-wide status page display settings,
// editable by super admins only.
model StatusPageSettings {
  id                String          @id @default("singleton")
  homePageDisplay   HomePageDisplay @default(BOTH)
  showRecentHistory Boolean         @default(true)
  recentHistoryDays Int             @default(14)
  updatedAt         DateTime        @updatedAt
}

model StatusGroup {
  id                 String              @id @default(cuid())
  name               String
  order              Int                 @default(0)
  // Whether this group (top-level or nested) starts expanded on the public
  // status page. Defaults true so existing groups keep today's behaviour
  // (top-level groups are always shown open, nested ones were the only kind
  // that could be collapsed at all before this field existed).
  defaultOpen        Boolean             @default(true)
  parentId           String?
  parent             StatusGroup?        @relation("GroupChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children           StatusGroup[]       @relation("GroupChildren")
  components         StatusComponent[]
  subscribers        StatusSubscriber[]
  webhookSubscribers WebhookSubscriber[]
  alertRules         AlertRule[]
}

model StatusComponent {
  id                    String                 @id @default(cuid())
  name                  String
  description           String?
  location              String? // e.g. "US · N. Virginia", shown as a location badge on the public page
  status                ComponentStatus        @default(OPERATIONAL)
  groupId               String?
  group                 StatusGroup?           @relation(fields: [groupId], references: [id])
  order                 Int                    @default(0)
  showUptime            Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  monitor               Monitor?
  incidentComponents    IncidentComponent[]
  maintenanceComponents MaintenanceComponent[]
  subscribers           StatusSubscriber[]
  webhookSubscribers    WebhookSubscriber[]
}

model Incident {
  id                    String              @id @default(cuid())
  name                  String
  status                IncidentStatus      @default(INVESTIGATING)
  impact                String              @default("none")
  startedAt             DateTime            @default(now())
  resolvedAt            DateTime?
  updates               IncidentUpdate[]
  components            IncidentComponent[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  postmortemBody        String?
  postmortemPublishedAt DateTime?
}

model IncidentComponent {
  id          String          @id @default(cuid())
  incidentId  String
  incident    Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  componentId String
  component   StatusComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  status      ComponentStatus

  @@unique([incidentId, componentId])
}

model IncidentUpdate {
  id         String         @id @default(cuid())
  body       String
  status     IncidentStatus
  incidentId String
  incident   Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
}

model ScheduledMaintenance {
  id             String                 @id @default(cuid())
  name           String
  status         MaintenanceStatus      @default(NOT_STARTED_YET)
  impact         String                 @default("none")
  description    String?
  scheduledStart DateTime
  scheduledEnd   DateTime
  updates        MaintenanceUpdate[]
  components     MaintenanceComponent[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model MaintenanceComponent {
  id            String               @id @default(cuid())
  maintenanceId String
  maintenance   ScheduledMaintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  componentId   String
  component     StatusComponent      @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([maintenanceId, componentId])
}

model MaintenanceUpdate {
  id            String               @id @default(cuid())
  message       String
  maintenanceId String
  maintenance   ScheduledMaintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())
}

// ─── Monitoring ───────────────────────────────────────────────────────────────

enum MonitorType {
  HTTP
  PING
  TCP
}

enum MonitorStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum MonitorBodyMatchType {
  NONE
  CONTAINS
  REGEX
  JSON_PATH
}

enum CheckResult {
  UP
  DOWN
  DEGRADED
}

enum AlertChannelType {
  DISCORD_WEBHOOK
  SLACK_WEBHOOK
  GENERIC_WEBHOOK
  EMAIL
}

enum AlertEvent {
  DOWN
  UP
  DEGRADED
  CERT_EXPIRY
}

model Monitor {
  id                   String               @id @default(cuid())
  name                 String
  type                 MonitorType          @default(HTTP)
  target               String // URL, IP, or hostname
  port                 Int? // for TCP
  interval             Int                  @default(60) // seconds between checks
  timeout              Int                  @default(10) // seconds before timeout
  downThreshold        Int                  @default(2) // consecutive DOWN checks required before lastStatus/component actually transition and alerts fire — absorbs a single transient blip (checker-side network hiccup, brief target hiccup) instead of flapping on it
  consecutiveFailures  Int                  @default(0) // internal counter toward downThreshold, not user-facing; resets to 0 on any non-DOWN check
  status               MonitorStatus        @default(ACTIVE)
  componentId          String?              @unique // linked status component
  component            StatusComponent?     @relation(fields: [componentId], references: [id], onDelete: SetNull)
  headers              Json? // custom request headers, e.g. { "Authorization": "Bearer xxx" } — HTTP only
  expectedStatusCodes  Int[]                @default([]) // empty = default 2xx/3xx success range — HTTP only
  bodyMatchType        MonitorBodyMatchType @default(NONE) // how expectedBodyContains is interpreted — HTTP only
  expectedBodyContains String? // substring, regex source, or dot-path depending on bodyMatchType — HTTP only
  expectedBodyValue    String? // expected value at expectedBodyContains's path — JSON_PATH only
  lastCheckedAt        DateTime?
  lastStatus           CheckResult?
  lastResponseMs       Int?
  uptime7d             Float? // cached uptime % over 7 days
  uptime30d            Float? // cached uptime % over 30 days
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  checks               MonitorCheck[]
  alertRules           AlertRule[]
}

model MonitorCheck {
  id         String      @id @default(cuid())
  monitorId  String
  monitor    Monitor     @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  result     CheckResult
  responseMs Int?
  statusCode Int?
  error      String?
  checkedAt  DateTime    @default(now())

  @@index([monitorId, checkedAt])
}

model AlertChannel {
  id        String           @id @default(cuid())
  name      String
  type      AlertChannelType
  config    Json // { url, token, email, etc. }
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  rules     AlertRule[]
}

model AlertRule {
  id        String       @id @default(cuid())
  monitorId String?
  monitor   Monitor?     @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  groupId   String?
  group     StatusGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  channelId String
  channel   AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  events    AlertEvent[]
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model AlertNotification {
  id        String     @id @default(cuid())
  monitorId String
  channelId String
  event     AlertEvent
  message   String
  sentAt    DateTime   @default(now())
  success   Boolean    @default(true)
  error     String?
}

enum SubscriberEvent {
  INCIDENT_CREATED
  INCIDENT_UPDATED
  INCIDENT_RESOLVED
  MAINTENANCE_SCHEDULED
  MAINTENANCE_UPDATED
}

model StatusSubscriber {
  id                String            @id @default(cuid())
  email             String            @unique
  verified          Boolean           @default(false)
  token             String            @unique @default(cuid())
  userId            String?           @unique
  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events            SubscriberEvent[] @default([INCIDENT_CREATED, INCIDENT_UPDATED, INCIDENT_RESOLVED, MAINTENANCE_SCHEDULED, MAINTENANCE_UPDATED])
  components        StatusComponent[]
  groups            StatusGroup[]
  createdAt         DateTime          @default(now())
}

model WebhookSubscriber {
  id         String            @id @default(cuid())
  webhookUrl String            @unique
  token      String            @unique @default(cuid())
  events     SubscriberEvent[] @default([INCIDENT_CREATED, INCIDENT_UPDATED, INCIDENT_RESOLVED, MAINTENANCE_SCHEDULED, MAINTENANCE_UPDATED])
  components StatusComponent[]
  groups     StatusGroup[]
  createdAt  DateTime          @default(now())
}
