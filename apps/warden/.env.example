# Bot token from the Discord Developer Portal → Bot → Reset Token
# (the Warden application, separate from the public Emberly bot)
DISCORD_TOKEN=

# Emberly server ID. Slash commands register here instantly; leave empty to register globally (up to an hour)
DISCORD_GUILD_ID=

# Channel that receives warnings, timeouts, kicks, bans and AutoMod actions
MOD_LOG_CHANNEL_ID=

# Channel for server events (joins, leaves, deleted/edited messages, role changes, ...).
# Falls back to MOD_LOG_CHANNEL_ID when empty
EVENT_LOG_CHANNEL_ID=

# Comma-separated channel IDs where common questions get an automatic FAQ answer.
# A forum channel's ID covers every post in it.
SUPPORT_CHANNEL_IDS=

# Invite codes AutoMod lets through (comma-separated). Defaults to the Emberly server invite
ALLOWED_INVITE_CODES=36spBmzZVB

# Status page summary used for the bot's presence and /status
STATUS_API_URL=https://emberlystat.us/api/status
STATUS_POLL_INTERVAL=60s
