{
  "name": "@emberly/bot",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "prisma": "^5.8.0",
    "@types/node": "^25.2.2"
  },
  "private": true,
  "license": "Elastic-2.0"
}
