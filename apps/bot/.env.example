# Discord application (Developer Portal → your app)
CLIENT_ID=""
BOT_TOKEN=""

# PostgreSQL
DATABASE_URL="postgresql://emberly:password@localhost:5432/emberly_bot"
# Only needed for `prisma migrate dev`
SHADOW_DATABASE_URL=""

# Comma-separated. Guild IDs get the developer commands;
# both lists are merged into the database on startup.
GUILD_IDS=""
DEV_IDS=""

# Channel that receives command error reports (optional)
ERROR_LOG_CHANNEL_ID=""

# Emberly site (default shown)
EMBERLY_API_URL="https://embrly.ca"

# debug | info | warn | error
LOG_LEVEL="info"
