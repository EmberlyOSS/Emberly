{
  "name": "emberly",
  "private": true,
  "license": "Elastic-2.0",
  "author": "CodeMeAPixel <https://codemeapixel.dev>",
  "homepage": "https://embrly.ca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmberlyOSS/Emberly.git"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/dashboard dev",
    "dev:docs": "bun run --cwd apps/docs dev",
    "dev:all": "turbo run dev",
    "build": "turbo run build --filter=@emberly/dashboard",
    "build:all": "turbo run build",
    "start": "bun run --cwd apps/dashboard start",
    "worker": "bun run --cwd apps/dashboard worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "db:generate": "turbo run db:generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:deploy": "bun run --cwd packages/db deploy",
    "db:seed": "bun run --cwd apps/dashboard db:seed",
    "previews:backfill": "bun run --cwd apps/dashboard previews:backfill",
    "db:studio": "bun run --cwd packages/db studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,json,md,css}": "prettier --write"
  },
  "overrides": {
    "zod": "^4.6.7",
    "nodemailer": "^10.2.1"
  }
}
